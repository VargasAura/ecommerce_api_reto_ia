# --- MySQL (docker compose) ---
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_DATABASE=ecommerce
MYSQL_USER=ecommerce
MYSQL_PASSWORD=changeme_app

# Puerto publicado de la API (host -> contenedor 8000)
API_PORT=8000

# --- API ---
# Compose inyecta DATABASE_URL hacia el servicio `db`.
# Si corres uvicorn en el host (sin Docker), usa localhost:
DATABASE_URL=mysql+pymysql://ecommerce:changeme_app@localhost:3306/ecommerce
